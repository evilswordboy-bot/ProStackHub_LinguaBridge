# =================================================================
# LinguaBridge AI — Environment Configuration Example
# =================================================================
# Copy this file to backend/.env and replace with your actual keys.
# NEVER commit your real .env file with secrets!

# Google Gemini API Key (Required for AI Translation & Detection)
GEMINI_API_KEY=

# Backend Server Port (Default: 5000)
PORT=5000

# Client Application URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Environment Mode: development | production | test
NODE_ENV=development

# Request Rate Limit (Requests allowed per IP per 15-minute window)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=900000
